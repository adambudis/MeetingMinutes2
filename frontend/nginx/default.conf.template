# Rendered by the nginx image at start-up (envsubst): ${BACKEND_UPSTREAM}, ${HTTPS_PORT}, ${MAX_UPLOAD_MB},
# ${NGINX_LOCAL_RESOLVERS}.
# nginx's own variables ($host, $uri, ...) are left untouched because no such env vars exist.

server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /certs/server.crt;
    ssl_certificate_key /certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Re-resolve the backend at request time so a recreated container (new IP) keeps working.
    # NGINX_LOCAL_RESOLVERS = nameservers from /etc/resolv.conf (127.0.0.11 inside docker compose),
    # filled in by the nginx image entrypoint because NGINX_ENTRYPOINT_LOCAL_RESOLVERS is set.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $backend http://${BACKEND_UPSTREAM};

    client_max_body_size ${MAX_UPLOAD_MB}m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events + large uploads: stream both directions, allow long silences.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The microphone only works on HTTPS; the UI links here from plain HTTP.
    location = /go-https {
        return 302 https://$host:${HTTPS_PORT}/;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }
}
