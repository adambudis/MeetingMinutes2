# Copy to .env and adjust. Read by docker compose (all values below are the defaults).

# Machine without an NVIDIA GPU: uncomment (use ';' instead of ':' as separator on Windows).
# COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml

# --- How users reach the server -------------------------------------------------------
# Host names / IPs users type in the browser, comma-separated. Used for the self-signed
# HTTPS certificate (microphone recording requires HTTPS). The certificate is re-created
# automatically on the next start when this value changes.
SERVER_HOSTS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Image versions ---------------------------------------------------------------------
# Set automatically by deploy/install-bundle.* when installing an offline bundle.
TAG=latest
OLLAMA_VERSION=0.40.16
# CUDA flavour of the PyTorch wheels: cu130 (NVIDIA driver >= 580) or cu128 (driver >= 570).
TORCH_CUDA=cu130

# --- LLM (Ollama) -------------------------------------------------------------------------
# Default: the bundled ollama container. For an Ollama installed on the host use
# http://host.docker.internal:11434 (the host Ollama must listen on 0.0.0.0).
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LLM_MODEL=gemma3:12b
LLM_NUM_CTX=65536
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1

# --- Speech-to-text -----------------------------------------------------------------------
# ASR models to load at start-up (comma-separated: canary, parakeet). Empty = load on first use.
WARMUP_MODELS=canary
MAX_UPLOAD_MB=500
# Only needed if the pyannote models are not in ./models/pyannote yet (online setup).
HF_TOKEN=
LOG_LEVEL=INFO
